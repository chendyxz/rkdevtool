{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rkdevtool",
  "version": "0.18.1",
  "identifier": "style.f.rkdevtool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RKDevTool",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRENTc3OTNCQzJDQzI1Q0EKUldUS0pjekNPM2xYVGZPOWk5MTdiY0J4RzdEN3JYK3UwUmF4bFFNRk1Xdms0VlRuQ3V1bEdmUXgK",
      "endpoints": [
        "https://github.com/chendyxz/rkdevtool/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
